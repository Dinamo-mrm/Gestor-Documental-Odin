rad }o--|| dep : id_dependencia
rad }o--|| est : id_estado
rad }o--|| tra : id_tramite
rad }o--o| rem : id_remitente
rad }o--o| ser : codigo_serie
rad }o--o| sub : codigo_subserie
rad }o--o| exp : id_expediente
rad ||--o{ doc : id_radicado
rad ||--o{ anx : id_radicado
