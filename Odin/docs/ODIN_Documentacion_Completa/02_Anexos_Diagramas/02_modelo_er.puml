rad ||--o{ obs : id_radicado
rad ||--o{ reas : id_radicado
rad ||--o{ notif : id_radicado
rad ||--o{ firm : id_radicado
rad ||--o{ aud : id_radicado
pla }o--o| usuarios : id_usuario
hist }o--|| usuarios : id_usuario
obs }o--o| usuarios : id_usuario
reas }o--o| usuarios : id_usuario_anterior
reas }o--o| usuarios : id_usuario_nuevo
reas }o--o| dep : id_dependencia_nueva
notif }o--|| usuarios : id_usuario
firm }o--|| usuarios : id_usuario
aud }o--|| usuarios : id_usuario

@enduml
